# Copy outside the repository to /etc/nrc-rag/service.env after cost approval.
# This template cannot make paid model calls: both controls start disabled.
NRC_PUBLIC_ORIGIN=https://nrc.example.invalid
ADAMS_MODEL_PROVIDER=groq
ADAMS_API_MODEL=openai/gpt-oss-120b
ADAMS_MODEL_API_KEY_FILE=/etc/nrc-rag/model-api.key
ADAMS_MODEL_BUDGET_DB=/srv/nrc/data/model-budget.sqlite
ADAMS_ALLOW_HOSTED_MODEL=0
ADAMS_MODEL_MONTHLY_USD=0
ADAMS_MIN_FREE_GB=5
