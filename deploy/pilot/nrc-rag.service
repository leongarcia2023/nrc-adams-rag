[Unit]
Description=NRC RAG pilot (loopback API)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=nrc
Group=nrc
WorkingDirectory=/srv/nrc/app
EnvironmentFile=/etc/nrc-rag/service.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HF_HOME=/srv/nrc/data/cache
Environment=OMP_NUM_THREADS=2
ExecStartPre=/usr/bin/test -s /srv/nrc/data/research.sqlite
ExecStartPre=/usr/bin/test -s /srv/nrc/data/catalog/catalog.sqlite
ExecStart=/srv/nrc/app/.venv/bin/python -m adams_rag.server --db /srv/nrc/data/research.sqlite --rate-db /srv/nrc/data/adams.sqlite --catalog /srv/nrc/data/catalog/catalog.sqlite --index-dir /srv/nrc/data/index-cpu --public-origin ${NRC_PUBLIC_ORIGIN} --offline-only --max-queued 8
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/nrc/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=256

[Install]
WantedBy=multi-user.target
